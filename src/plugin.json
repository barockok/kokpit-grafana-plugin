{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Kokpit SLO",
  "id": "zidmubarock-slo-app",
  "info": {
    "keywords": ["slo", "sli", "error-budget"],
    "description": "SLO config wizard with live dashboard preview",
    "author": {
      "name": "Kokpit",
      "url": "https://github.com/barockok"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      { "name": "GitHub", "url": "https://github.com/barockok/kokpit" },
      { "name": "License", "url": "https://github.com/barockok/kokpit/blob/master/grafana-plugin/LICENSE" },
      { "name": "Issues", "url": "https://github.com/barockok/kokpit/issues" }
    ],
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "SLO Wizard",
      "path": "/a/%PLUGIN_ID%/wizard",
      "addToNav": true,
      "defaultNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=11.6.0",
    "plugins": []
  }
}
